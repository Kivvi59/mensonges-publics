---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const mensonges = (await getCollection('mensonges')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatter = new Intl.DateTimeFormat('fr-FR', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});
---

<BaseLayout description="Liste de mensonges de personnalités publiques, avec sources vérifiables.">
	<section class="hero wrap">
		<p class="eyebrow">Archives sourcées</p>
		<h1>Mensonges <em>Publics</em></h1>
		<p class="lede">
			Des propos trompeurs de personnalités publiques, classés et documentés —
			cliquez un titre pour le contexte et les sources.
		</p>
	</section>

	<section class="list wrap" aria-label="Liste des mensonges">
		{
			mensonges.map((entry, index) => (
				<article class="item" style={`--i: ${index}`}>
					<p class="meta">
						<span class="badge">Mensonge</span>
						<span>{entry.data.personality}</span>
						<span aria-hidden="true">·</span>
						<time datetime={entry.data.date.toISOString()}>
							{formatter.format(entry.data.date)}
						</time>
					</p>
					<h2>
						<a href={`/mensonges/${entry.id}/`}>{entry.data.title}</a>
					</h2>
					<p class="summary">{entry.data.summary}</p>
				</article>
			))
		}
	</section>
</BaseLayout>

<style>
	.hero {
		padding: 2.5rem 0 2rem;
		animation: rise-in 700ms var(--ease) both;
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--signal);
	}

	h1 {
		margin: 0;
		font-family: var(--font-brand);
		font-weight: 800;
		font-size: clamp(2.6rem, 8vw, 4.4rem);
		line-height: 0.95;
		letter-spacing: -0.04em;
		color: var(--ink);
	}

	h1 em {
		font-style: normal;
		color: var(--signal);
	}

	.lede {
		margin: 1.25rem 0 0;
		max-width: 36rem;
		color: var(--ink-soft);
		font-size: 1.15rem;
	}

	.list {
		display: grid;
		gap: 0;
		padding-bottom: 1rem;
	}

	.item {
		padding: 1.5rem 0;
		border-top: 1px solid var(--line);
		animation: rise-in 700ms var(--ease) both;
		animation-delay: calc(80ms * var(--i) + 120ms);
	}

	.item:last-child {
		border-bottom: 1px solid var(--line);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem 0.6rem;
		margin: 0 0 0.55rem;
		color: var(--ink-soft);
		font-size: 0.92rem;
	}

	.badge {
		display: inline-block;
		padding: 0.15rem 0.45rem;
		border-radius: 0.25rem;
		background: var(--signal-soft);
		color: var(--signal);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		font-family: var(--font-brand);
		font-size: clamp(1.35rem, 3.5vw, 1.7rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	h2 a {
		position: relative;
		color: var(--ink);
		text-decoration: none;
	}

	h2 a::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: -0.12em;
		width: 100%;
		height: 2px;
		background: var(--signal);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 320ms var(--ease);
	}

	h2 a:hover::after,
	h2 a:focus-visible::after {
		transform: scaleX(1);
	}

	.summary {
		margin: 0.65rem 0 0;
		color: var(--ink-soft);
		max-width: 40rem;
	}
</style>
